  "decision_rows": [
    {
      "gate": "RowGapModelPinned",
      "closed": true,
      "proved": true,
      "meaning": "固定奇素数 P 与 1<=k<P，审查内部行 I_k={kP+a:1<=a<P} 无素数的反例模型。",
      "remaining": "zero row means every a is covered by a prime divisor < P"
    },
    {
      "gate": "CorrectDivisorSupplyLaw",
      "closed": true,
      "proved": true,
      "meaning": "若 kP+a 合数且 a<P，则 kP+a<P^2，所以它有一个素因子 q<P。",
      "remaining": "small-prime cover by q<P"
    },
    {
      "gate": "LowRootOnlyClaimRejected",
      "closed": true,
      "proved": true,
      "meaning": "不能只用 q<=sqrt(kP)：近根带 sqrt(kP)<q<=sqrt(kP+P-1) 可能覆盖边缘半素数槽。",
      "remaining": "split low-root supply and near-root slots"
    },
    {
      "gate": "ExactCoverObligation",
      "closed": true,
      "proved": false,
