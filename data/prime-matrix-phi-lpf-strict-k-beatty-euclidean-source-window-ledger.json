  "formula": {
    "carrier_source_row": "j=floor(k/m)",
    "integer_window": "floor(tP/m)+1 <= b <= floor(((t+1)P-1)/m)",
    "payment_count": "B_P(k)=sum_{m=2}^k #{prime r=jP+b in the source window}",
    "residue_decomposition": "k=mj+t, 0<=t<m, r=jP+b",
    "source_window": "tP < m b < (t+1)P"
  },
  "gates": [
    {
      "closed": true,
      "gate": "EuclideanSourceRowLawClosed",
      "meaning": "若 carrier 为 m，则源素数 r 必在源行 j=floor(k/m)。",
      "proved": true,
      "remaining": "exact quotient source row"
    },
    {
      "closed": true,
      "gate": "ResidueWindowLawClosed",
      "meaning": "写 k=mj+t 后，源行余数 b 必满足 tP < mb < (t+1)P。",
      "proved": true,
      "remaining": "rational residue window"
    },
    {
      "closed": true,
      "gate": "BeattyPaymentEqualsQuotientWindowPrimeCountClosed",
      "meaning": "B_P(k) 等于所有欧几里得商源行窗口中的素数计数之和。",
      "proved": true,
      "remaining": "source-window payment table"
    },
    {
      "closed": true,
      "gate": "LowerHalfSourceCutRefined",
      "meaning": "j=floor(k/m)<=floor(k/2)，所以下半源切口是该商行定律的直接推论。",
      "proved": true,
      "remaining": "lower-half source is quotient law"
    },
    {
      "closed": false,
      "gate": "BeattySmoothAntiTilingProved",
      "meaning": "本层没有证明这些源行窗口与 P-smooth 槽不能共同铺满目标行。",
