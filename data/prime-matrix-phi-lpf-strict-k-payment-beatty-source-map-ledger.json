  "gates": [
    {
      "closed": true,
      "gate": "UniqueCarrierForSourcePrimeClosed",
      "meaning": "固定源素数 r>P 时，区间 (kP/r,((k+1)P-1)/r] 长度小于 1，因此至多一个 carrier。",
      "proved": true,
      "remaining": "unique carrier"
    },
    {
      "closed": true,
      "gate": "BeattyCarrierFormulaClosed",
      "meaning": "若存在 carrier，则必为 m=floor(kP/r)+1。",
      "proved": true,
      "remaining": "canonical carrier"
    },
    {
      "closed": true,
      "gate": "NearMultipleResidueCriterionClosed",
      "meaning": "payment 槽位为 a=r-(kP mod r)，且 payment 当且仅当 1<=a<P。",
      "proved": true,
      "remaining": "near-multiple source criterion"
    },
    {
      "closed": true,
      "gate": "HmPaymentEqualsBeattySourceCountClosed",
      "meaning": "sum_{2<=m<=k} H_m(k,P) 等于满足近倍数准则的下半源素数个数。",
      "proved": true,
      "remaining": "exact source-table equality"
    },
    {
      "closed": true,
      "gate": "ZeroRowReducedToBeattySourcePlusSmoothTiling",
      "meaning": "零行反设等价于 Beatty 近倍数源像与 P-smooth 槽铺满全部行槽。",
      "proved": true,
      "remaining": "Beatty-source image + smooth = all slots"
    },
    {
      "closed": false,
      "gate": "BeattySmoothAntiTilingProved",
      "meaning": "当前语料尚未证明 Beatty 近倍数源像不能与 P-smooth 槽完美铺满。",
      "proved": false,
      "remaining": "Beatty smooth anti-tiling inequality"
    },
    {
      "closed": false,
      "gate": "RowColumnUnconditionalClosureReached",
      "meaning": "本层规范化 payment 源表，但不证明 strict 行正性。",
      "proved": false,
      "remaining": "anti-tiling, rejection excess, or sqrt-scale input"
    }
  ],
  "no_theorem_switch": true,
  "plain_conclusion": "low-carrier payment 的下半源注入可被完全规范成唯一 Beatty 近倍数映射：源素数 r>P 是否支付目标行，只取决于 kP mod r 是否落在 r-P+1 到 r-1 的尾段。因此零行反例必须由这张近倍数源像与 P-smooth 槽完美铺满；当前层未证明该Beatty/smooth 反铺满不等式。",
