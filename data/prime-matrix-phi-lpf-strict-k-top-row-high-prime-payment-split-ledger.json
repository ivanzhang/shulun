  "high_prime_factor_split": "P-1 = H_1(P)+sum_{2<=m<P}H_m(P)+S_P(P)",
  "low_carrier_payment_capacity_exceeded": false,
  "low_carrier_payment_term": "H_m(P)=pi(floor((P^2-1)/m))-pi(floor((P^2-P)/m)), 2<=m<P",
  "no_theorem_switch": true,
  "plain_conclusion": "顶行的 high-prime 泄出分成三块：m=1 是真正的素数槽，2<=m<P 是低载体高素数 payment，剩余是所有素因子 <=P 的 smooth 合数槽。目标正性就是证明 m=1 非空。Sylvester-Schur 在 m=1 为空的反设下只推出低载体 payment 非空，不能直接推出矛盾；要闭合还必须证明低载体 payment 加 smooth 槽不能铺满全部 P-1 个槽位。",
  "prime_slot_term": "H_1(P)=pi(P^2-1)-pi(P^2-P)",
  "row_column_unconditional_closed": false,
  "same_theorem_target_preserved": true,
  "smooth_term": "S_P(P)=# top-row composite slots with all prime factors <=P",
