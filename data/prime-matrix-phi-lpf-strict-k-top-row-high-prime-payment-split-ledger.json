      "remaining": "prove H_1(P)>=1"
    },
    {
      "closed": true,
      "gate": "SylvesterSchurLeakLocated",
      "meaning": "若 m=1 为空，连续乘积输入只强制 2<=m<P 的低载体 payment 非空。",
      "proved": true,
      "remaining": "single leak is not positivity"
    },
    {
      "closed": false,
      "gate": "LowCarrierPaymentCapacityExceeded",
      "meaning": "当前语料没有证明低载体 payment 与 P-smooth 槽的合计容量小于 P-1。",
