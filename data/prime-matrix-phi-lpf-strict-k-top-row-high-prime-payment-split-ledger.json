      "remaining": "capacity deficit or positive rejection excess"
    },
    {
      "closed": false,
      "gate": "RowColumnUnconditionalClosureReached",
      "meaning": "本层只定位 high-prime leak 的真实落点。",
      "proved": false,
      "remaining": "strict row positivity still open"
    }
