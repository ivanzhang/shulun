      "proved": true,
      "remaining": "LeastPrimeFactorOwnershipUnsignedSourceDeclarationLedger"
    },
    {
      "closed": true,
      "gate": "PhiRoughCountDefinitionClosed",
      "meaning": "Phi(x,p) 定义为 1<=m<=x 且无小于 p 的素因子的 rough 计数，包含 m=1。",
      "proved": true,
      "remaining": "PhiRecursiveLPFOwnershipRoughCountLedger"
    },
    {
      "closed": true,
      "gate": "PhiRecursionIdentityClosed",
      "meaning": "按是否被 p_k 整除分拆，得到 Phi(x,p_k)=Phi(x,p_{k+1})+Phi(floor(x/p_k),p_k)。",
      "proved": true,
      "remaining": "PhiRecursiveLPFOwnershipRoughCountLedger"
    },
    {
      "closed": true,
      "gate": "LPFBucketEqualsPhiMinusOneClosed",
      "meaning": "p 层新筛合数数 c(p)=Phi(floor(N/p),p)-1；减去的 1 是 cofactor m=1 对应的素数 p。",
      "proved": true,
      "remaining": "PhiRecursiveLPFOwnershipRoughCountLedger"
    },
    {
      "closed": true,
      "gate": "PrimeCountingIdentityFromPhiLPFClosed",
      "meaning": "求和 p<=sqrt(N) 的 Phi 桶后得到 pi(N)=N-1-sum_p(Phi(floor(N/p),p)-1)。",
      "proved": true,
      "remaining": "PhiRecursiveLPFOwnershipRoughCountLedger"
    },
    {
      "closed": true,
      "gate": "LargePrimeLayerZeroMassClosed",
      "meaning": "当 p>sqrt(N) 时 floor(N/p)<p，Phi(floor(N/p),p)=1，故 c(p)=0。",
      "proved": true,
      "remaining": "PhiRecursiveLPFOwnershipRoughCountLedger"
    },
    {
      "closed": true,
      "gate": "CandidateRowMapImported",
      "meaning": "Phi 递推加强 LPF candidate-row map 的源计数，但不改变其 unsigned 性质。",
      "proved": true,
      "remaining": "LPFOwnershipAlphaCandidateRowEmissionMapLedger"
    },
    {
      "closed": true,
      "gate": "PhiOwnershipDoesNotEmitSignedWeight",
      "meaning": "Phi 递推只计算 rough ownership 容量；它不赋 orientation、signed coefficient、local factor 或 primitive summand。",
      "proved": true,
      "remaining": "ActualNoncanonicalPrimitiveSummandSignedWeightExpressionBeforePushforward"
    },
    {
      "closed": true,
      "gate": "PrimitiveSummandSignedExpressionStillOpen",
      "meaning": "逐行 signed primitive summand 表达式仍是 LPF/Phi 无符号层之后的真正硬点。",
      "proved": false,
      "remaining": "ActualNoncanonicalPrimitiveSummandSignedWeightExpressionBeforePushforward"
    },
    {
      "closed": false,
      "gate": "RowColumnUnconditionalClosureReached",
      "meaning": "本步没有证明 signed alpha/delta、pairing、ExactUV fixed-key、DStructure/Rankin 或 endpoint 排斥。",
      "proved": false,
      "remaining": "ActualNoncanonicalPrimitiveSummandSignedWeightExpressionBeforePushforward"
    }
  ],
