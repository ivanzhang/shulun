  "hardpoint_after_router": "(PhiLPFUnitCofactorVirtualSeedOrSquareBaseSignedCoefficientBeforePushforward AND PhiLPFRoughCofactorStepLocalFactorUpdateLawBeforePushforward AND PhiLPFRoughCofactorOrderedFactorizationCoherenceBeforePushforward) OR PointwiseSignedCoefficientValueTableOnPhiLPFBucketSupportBeforePushforward",
  "next_direct_attack_target": "PhiLPFUnitCofactorVirtualSeedOrSquareBaseSignedCoefficientBeforePushforward",
  "no_theorem_switch": true,
  "parallel_direct_attack_target": "PointwiseSignedCoefficientValueTableOnPhiLPFBucketSupportBeforePushforward",
  "phi_lpf_bucket_signed_coefficient_law_proved": false,
  "phi_lpf_rough_cofactor_signed_transport_law_proved": false,
  "phi_lpf_signed_transport_unit_seed_router_closed": true,
  "phi_minus_one_prime_row_guard_imported": true,
  "plain_conclusion": "Phi 计数公式中的 `-1` 是 signed transport 的关键边界：`m=1` 被从 composite support 中排除，但 rough cofactor 乘法分支又必须从 `m'=1` 生成平方基 key `(p,p)`。因此递推 signed transport 不能从 Phi 计数自动启动；它首先需要 virtual-unit seed 或 square-base signed coefficient，并明确禁止把 prime row `p` 偷换成 composite signed seed。最新硬点压成 `PhiLPFUnitCofactorVirtualSeedOrSquareBaseSignedCoefficientBeforePushforward`。",
  "pointwise_phi_lpf_bucket_signed_value_table_proved": false,
  "rough_cofactor_ordered_factorization_coherence_proved": false,
  "rough_cofactor_step_local_factor_update_law_proved": false,
  "row_column_unconditional_closed": false,
  "same_theorem_target_preserved": true,
