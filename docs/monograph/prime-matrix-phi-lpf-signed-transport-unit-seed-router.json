      "proved": true,
      "remaining": "PhiLPFUnitCofactorVirtualSeedOrSquareBaseSignedCoefficientBeforePushforward"
    },
    {
      "closed": true,
      "gate": "SupportBijectionConfirmsSquareBaseKeys",
      "meaning": "平方基 key 是 Phi-LPF support 的合法起点，但 unit cofactor 本身不是 support key。",
      "proved": true,
      "remaining": "PhiLPFUnitCofactorVirtualSeedOrSquareBaseSignedCoefficientBeforePushforward"
    },
    {
      "closed": true,
      "gate": "TransportCannotStartWithoutSeed",
