  "closed_gates": [
    {
      "closed": true,
      "gate": "ComplementaryPairLocalRamanujanTensorNormalForm",
      "meaning": "Every complementary pair kernel has the exact local product sum K_q(n)=mu(q)prod rho_l + mu(W/q)prod rho_l.",
      "proved": true,
      "remaining": "none"
    },
    {
      "closed": true,
      "gate": "ComplementaryPairUnitOrbitRadiality",
      "meaning": "The pair kernel depends only on gcd(n,W_P) and is invariant under multiplication by units modulo W_P.",
      "proved": true,
      "remaining": "none"
    },
    {
      "closed": true,
      "gate": "ComplementaryPairTwoCylinderRankLedger",
      "meaning": "Non-endpoint complementary pairs have exact two-cylinder matrix rank 2; the endpoint pair has rank 1.",
      "proved": true,
      "remaining": "none"
    },
    {
      "closed": true,
      "gate": "DirectKloostermanTraceInputFromPairKernelRejected",
      "meaning": "The raw pair kernel contains no reciprocal inverse phase and cannot be directly fed to Kloosterman/trace bilinear theorems.",
      "proved": true,
      "remaining": "none"
    },
    {
      "closed": false,
      "gate": "ComplementaryConductorPairPhaseMatchingOrTraceFamilyBridge",
      "meaning": "Introduce a genuine same-object reciprocal/trace phase coupled to the radial pair kernels.",
      "proved": false,
      "remaining": "new phase-matching bridge theorem"
    },
    {
      "closed": false,
      "gate": "UniformCancellationAcrossComplementaryPrimorialConductorPairs",
      "meaning": "Prove uniform cancellation after the phase bridge, across all dynamic primorial complementary pairs.",
      "proved": false,
      "remaining": "new pair-uniform cancellation theorem"
    }
  ],
  "complementary_pair_local_tensor_normal_form_closed": true,
