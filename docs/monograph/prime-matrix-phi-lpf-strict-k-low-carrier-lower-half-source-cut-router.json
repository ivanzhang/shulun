  "frontier_sync_only": true,
  "gates": [
    {
      "closed": true,
      "gate": "LowCarrierPaymentSourceIntervalClosed",
      "meaning": "若 n=mr 落在 strict 行且 r>P 为素数、m>=2，则 r 位于 (kP/m,((k+1)P-1)/m]。",
      "proved": true,
      "remaining": "exact source interval"
    },
    {
      "closed": true,
      "gate": "PaymentSourceLowerHalfCutClosed",
      "meaning": "因 m>=2，所有 payment prime r 都满足 r<((k+1)P)/2<kP。",
      "proved": true,
      "remaining": "source row <= floor(k/2)"
    },
    {
      "closed": true,
      "gate": "SameRowAndFuturePaymentLoopExcluded",
      "meaning": "low-carrier payment 不能来自当前行、近顶端行或未来行。",
      "proved": true,
      "remaining": "acyclic lower-half source only"
    },
    {
      "closed": true,
      "gate": "PaymentInjectionPerSourcePrimeClosed",
      "meaning": "固定目标行内，一个源素数 r>P 至多对应一个 carrier m，因为相邻 m 的乘积差为 r>P。",
      "proved": true,
      "remaining": "injective source-to-slot map"
    },
    {
      "closed": true,
      "gate": "ZeroRowReducedToLowerHalfPaymentPlusSmoothTiling",
      "meaning": "若 strict 行为零素数行，则所有槽必须由下半源 payment 注入像与 P-smooth 槽铺满。",
      "proved": true,
      "remaining": "lower-half payment image + smooth = all slots"
    },
    {
      "closed": false,
      "gate": "LowerHalfPaymentSmoothAntiTilingProved",
      "meaning": "当前语料尚未证明下半源 payment 像与 P-smooth 槽不能完美铺满全部行槽。",
      "proved": false,
      "remaining": "global lower-half payment/smooth anti-tiling inequality"
    },
    {
      "closed": false,
      "gate": "RowColumnUnconditionalClosureReached",
      "meaning": "本层排除 payment 来源环并压窄剩余，但不证明 strict 行正性。",
      "proved": false,
      "remaining": "anti-tiling, rejection excess, or sqrt-scale input"
    }
  ],
  "lower_half_payment_smooth_anti_tiling_proved": false,
  "no_theorem_switch": true,
  "plain_conclusion": "low-carrier high-prime payment 不是当前行的自反馈来源：每个支付素数 r>P 都落在当前行左侧并且最多位于 floor(k/2) 行。于是零行反例必须表现为早期下半源 prime injection 与 P-smooth 槽的完美铺满。当前层关闭来源环，但尚未证明该下半源 payment/smooth 反铺满不等式。",
  "row_column_unconditional_closed": false,
  "same_theorem_target_preserved": true,
  "source_cut_statement": "For every payment slot n=mr with 2<=m<=k and prime r>P, one has r<((k+1)P)/2<kP and floor(r/P)<=floor(k/2).",
