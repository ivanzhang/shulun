  },
  "source_injection_statement": "For fixed target row (P,k), each source prime r>P contributes to at most one low-carrier payment slot, since two carriers differ by at least r>P.",
  "status": "strict_k_low_carrier_payment_reduced_to_acyclic_lower_half_source_injection",
  "strict_k_range": "1<k<P",
  "zero_row_consequence": "A zero row must be a perfect tiling by the image of an acyclic lower-half payment injection plus the P-smooth slots."
}
