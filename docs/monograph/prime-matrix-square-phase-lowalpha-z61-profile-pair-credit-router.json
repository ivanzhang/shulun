    "experiments/prime_matrix_square_phase_lowalpha_z61_profile_pair_credit_router.py": "dd18a4f912a83c85a849fe033be56bd3f16a09ed4b429f150822b984d2b85271",
    "docs/monograph/prime-matrix-square-phase-lowalpha-z61-profile-sign-pattern-router.json": "f37d1d58c9c03c95badb956c102919ebd6a69db811139157393a1123f0a52d1b"
  },
  "next_direct_attack_target": "DominantPProfilePairCreditLowerBoundOrPairDefectPDEC",
  "plain_conclusion": "每个深度格的反号信用已拆成正 profile P 与负 profile P 的配对信用矩阵。配对规则是规范化运输：若正质量为 P_+、负质量为 P_-，则 `credit(P_i,P_j)=2*pos_i*neg_j/max(P_+,P_-)`，逐格求和精确恢复上一层反号信用。因此下一步可以只攻主要 P-pair 的持续信用下界；若主要 pair 信用消失，则输出 PairDefect-PDEC。"
}
