    {
      "closed": true,
      "gate": "EndpointDifferenceIdentityClosed",
      "meaning": "Pi(B)-Pi(A-1) 可写成长度减去所有 LPF 桶的 Phi 端点差分。",
      "proved": true,
      "remaining": "exact identity, not an asymptotic"
    },
    {
      "closed": true,
      "gate": "KPToKPPlusPFormulaClosed",
      "meaning": "对闭区间 [kP,kP+P]，长度项为 P+1，合数项为 p<=sqrt(kP+P) 的 Phi 差分和。",
      "proved": true,
      "remaining": "P+1 - sum_p Delta_Phi_p"
    },
    {
      "closed": true,
